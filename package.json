    "prettier-plugin",
    "markdown",
    "mdx",
    "table",
    "formatter"
  ],
  "homepage": "https://github.com/cspidar/prettier-plugin-markdown-compact-tables#readme",
  "bugs": {
    "url": "https://github.com/cspidar/prettier-plugin-markdown-compact-tables/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cspidar/prettier-plugin-markdown-compact-tables.git"
  },
  "license": "MIT",
  "author": "cspidar",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
